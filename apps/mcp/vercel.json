{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PLANME_TRANSIT_ACCESS_RECOVERY_MODE": "on"
  },
  "functions": {
    "api/gpt/itineraries/recommend.ts": {
      "maxDuration": 60
    },
    "api/mcp.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
